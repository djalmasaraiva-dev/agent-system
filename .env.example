# --- Vertex AI / Gemini Enterprise Agent Platform ---------------------------
GOOGLE_CLOUD_PROJECT=acme-financials
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# Models — latest from https://ai.google.dev/gemini-api/docs/models.
# This project pins Gemini 3.1 (the latest family available on Vertex AI).
COORDINATOR_MODEL=gemini-3.1-pro-preview
RESEARCH_MODEL=gemini-3.1-pro-preview
DATA_MODEL=gemini-3-flash-preview
REPORTER_MODEL=gemini-3-flash-preview

# --- BigQuery (data_agent) --------------------------------------------------
# Skill reference: github.com/google/skills/tree/main/skills/cloud/bigquery-basics
BIGQUERY_DATASET=analytics
BIGQUERY_LOCATION=US
BIGQUERY_MAX_BYTES_BILLED=1073741824   # 1 GiB cost guard per query
BIGQUERY_MAX_ROWS=1000

# --- Identity bridge metadata (per-agent service deployment) ----------------
# Each Cloud Run service hosts ONE agent. The bridge endpoint at
# /.well-known/agent-identity reflects this AGENT_NAME.
AGENT_NAME=coordinator
AGENT_VERSION=2.4.1
AGENT_OWNER_EMAIL=risk-analytics-lead@example.com
AGENT_FALLBACK_OWNER_EMAIL=ai-platform-ops@example.com
AGENT_BUSINESS_UNIT=Risk & Analytics
AGENT_CLASSIFICATION=high-risk-data-access
AGENT_BUSINESS_CONTEXT=Coordinates a research+data+reporter workflow for analyst questions.
AGENT_DECOMMISSION_AFTER=2026-09-30T00:00:00Z

# --- IAP for Agents (Identity-Aware Proxy) ----------------------------------
# Audience format for Cloud Run behind external HTTPS LB + IAP:
#   /projects/PROJECT_NUMBER/global/backendServices/SERVICE_ID
# Leave blank with IAP_REQUIRED=false for local dev.
IAP_EXPECTED_AUDIENCE=
IAP_REQUIRED=false

# --- Server / observability -------------------------------------------------
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
ENABLE_CLOUD_TRACE=true
SERVICE_NAME=agent-system
